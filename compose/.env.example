# Copy to `.env` in this directory (same folder as docker-compose*.yml):
#   cp .env.example .env
# Docker Compose loads `.env` here for variable substitution (including included mediamtx stacks).

# Comma-separated hostnames/IPs of THIS machine as seen by WebRTC/WHEP clients (LAN or routed).
MTX_WEBRTC_ADDITIONAL_HOSTS=10.1.101.211

# Optional: backend **GENERATION_MODE** (default **synthetic_channel_based** → **SYNTHETIC_FAPI**). Compose files set **GENERATION_MODE** on the **backend** service.
# GENERATION_MODE=SYNTHETIC_RESOURCE_GRID
