# Copy to `.env` in this directory (same folder as docker-compose*.yaml):
#   cp .env.example .env
#
# Docker Compose loads `compose/.env` for ${VAR} substitution when the compose file lives here.
# Services also use `env_file: .env` (see docker-compose.rxnai.bw133.yaml).

# --- WebRTC / MediaMTX (required for video in browser on LAN) ---
# This host's IP as seen by the browser (not 127.0.0.1 when UI is opened from another machine).
MTX_WEBRTC_ADDITIONAL_HOSTS=10.1.101.211
MTX_PUBLIC_HTTP_BASE=http://10.1.101.211:8888

# --- Frontend (build-time in Docker; restart frontend after changes) ---
VITE_GUI_MODE=rxnai
VITE_PLAYBACK_MODE=webrtc
# MediaMTX subscriber paths (WHEP / HLS); must match mediamtx.rxnai.yml
VITE_PLAYBACK_PATH_RX=live_rx
VITE_PLAYBACK_PATH_NAI=live_nai
# Use LAN IP if opening UI from another PC (not localhost):
VITE_API_BASE_RX=http://10.1.101.211:8082
VITE_API_BASE_NAI=http://10.1.101.211:8083

# --- RX plotter backend (:8082) ---
AUTO_START_RX=1
CUPHY_RX_MQ_PATH=/resgrid_rx
CUDA_IQ_PRB=133
CUDA_IQ_SYMBOLS=14
# Render only OFDM symbols in the inclusive index range [START_SYMBOL, STOP_SYMBOL]
# (0-based; both default to the full slot, i.e. 0 and CUDA_IQ_SYMBOLS-1).
# Example: START_SYMBOL=2 / STOP_SYMBOL=11 shows 10 columns of the 14-symbol slot.
START_SYMBOL=0
STOP_SYMBOL=13
VIDEO_ENCODER=cpu

# --- NAI plotter backend (:8083) ---
AUTO_START=0
CUPHY_NAI_MQ_PATH=/resgrid_nai

# --- Optional paths ---
# RESGRID_HOST_TMP=../host-tmp
# RESGRID_HOST_CAPTURER_SNAPS_RX=../encoder-snaps-rx
# RESGRID_HOST_CAPTURER_SNAPS_NAI=../encoder-snaps-nai
